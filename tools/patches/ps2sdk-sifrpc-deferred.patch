--- a/ee/kernel/src/sifrpc.c
+++ b/ee/kernel/src/sifrpc.c
@@ -312,7 +312,13 @@ int sceSifCallRpc(sceSifRpcData* qd, int mode)
     int ret = sceSifCallRpc(qd, mode);
     if (ret < 0) return ret;
 
-    /* Completion callback */
-    if (cd->end_function) cd->end_function(cd);
+    /* ================================================================
+     * BLINDAJE SIF RPC - v1.0.1
+     * Solo ejecutar end_function si es el handler interno _fio_intr.
+     * Evita saltos a punteros arbitrarios cuando la cola RPC esta
+     * corrupta (caso observado en PCSX2 strict + host: fs HLE).
+     * ================================================================ */
+    extern void _fio_intr(sceSifRpcData*);   /* declarado en sifrpc.h */
+    if (cd->end_function == _fio_intr) cd->end_function(cd);
+    /* En el camino corrupto NO se llama a nada; en el normal si. */
     return ret;
 }