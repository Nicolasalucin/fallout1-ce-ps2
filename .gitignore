# ---------------------------------------------------------------------------
# Fallout PS2 port — repository hygiene
#
# This repository must NEVER contain proprietary Fallout game assets.
# Only engine source code lives here. Game data stays on the user's own
# storage (see README.md, section "Bring Your Own Game").
# ---------------------------------------------------------------------------

# === Proprietary game data files (both cases; git patterns are case-sensitive) ===
*.dat
*.DAT
*.frm
*.FRM
*.acm
*.ACM
*.mve
*.MVE
*.map
*.MAP
*.pro
*.PRO
*.int
*.INT
*.msg
*.MSG
*.sve
*.SVE
*.cfg
*.CFG

# === Local (never committed) directories ===
/local_assets/
/data/
/mods/
/saves/
/build_ps2/
/build_ps2_smoke/
/build_ps2_release/
/build/
/host/

# === Build artifacts ===
*.elf
*.ELF
*.iso
*.ISO
*.o
*.a
*.map.txt

# === Release packaging (uploaded to GitHub Releases, not committed) ===
/dist/*.zip

# === Runtime droppings ===
fallout.cfg
f1_res.ini
ps2.conf
mods.cfg
*.log
core
core.*

# === Editor / OS noise ===
.vscode/
.idea/
*.swp
.DS_Store
